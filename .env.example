# --- Google OAuth (login de los usuarios) ---
# Consola de Google Cloud > Credenciales > ID de cliente OAuth (aplicacion web).
# Origen autorizado: http://localhost:3000
# URI de redireccion: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Solo entran cuentas de este dominio. Vacio = cualquier cuenta de Google.
ALLOWED_DOMAIN=

# Clave para firmar la cookie de sesion. Generar con: openssl rand -base64 32
SESSION_SECRET=

# --- Procesamiento de la reunion ---
# Gemini escucha el audio y escribe la minuta. Tiene nivel gratuito.
# Clave en https://aistudio.google.com/apikey (es distinta del OAuth de arriba).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# mock (sin credenciales) | gemini | deepgram | assemblyai
TRANSCRIBER=mock
# mock (sin credenciales) | gemini
SUMMARIZER=mock

# Alternativas de transcripcion, solo si la separacion de voces de Gemini
# no alcanza en reuniones presenciales con muchas personas.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Destino de los archivos ---
# mock (queda en disco) | drive
UPLOADER=mock
# Carpeta de Drive donde se crea /Reuniones/AAAA/MM/...
# Poner el id de una unidad compartida de la empresa. Vacio = Drive del usuario.
DRIVE_ROOT_FOLDER_ID=

# Dias que se conserva el audio crudo. La minuta y la transcripcion quedan siempre.
AUDIO_RETENTION_DAYS=90
